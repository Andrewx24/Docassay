{
  "explicit.yaml": {
    "version": 1,
    "golden": "golden",
    "cache": "cache",
    "baseline": "base.json",
    "parsers": [
      {
        "id": "docling"
      }
    ],
    "thresholds": {
      "default": {
        "drop": 0
      }
    },
    "normalize": {
      "date_order": "mdy",
      "decimal": ","
    },
    "tokenizer": "words"
  },
  "full.yaml": {
    "version": 1,
    "golden": "golden",
    "cache": ".docassay/cache",
    "baseline": ".docassay/baseline.json",
    "parsers": [
      {
        "id": "docling"
      },
      {
        "id": "llamaparse:agentic",
        "options": {
          "version": "2026-09-24"
        }
      },
      {
        "id": "file",
        "name": "my-pipeline",
        "options": {
          "dir": "out/parsed"
        }
      }
    ],
    "thresholds": {
      "default": {
        "drop": 0.02
      },
      "tables": {
        "drop": 0.01,
        "min": 0.8
      }
    },
    "normalize": {
      "date_order": "mdy",
      "decimal": "."
    },
    "tokenizer": "words"
  },
  "minimal.yaml": {
    "version": 1,
    "golden": "golden",
    "cache": ".docassay/cache",
    "baseline": ".docassay/baseline.json",
    "parsers": [
      {
        "id": "docling"
      }
    ],
    "thresholds": {
      "default": {
        "drop": 0.02
      }
    },
    "normalize": {
      "date_order": "mdy",
      "decimal": "."
    },
    "tokenizer": "words"
  },
  "partial.yaml": {
    "version": 1,
    "golden": "sets",
    "cache": ".docassay/cache",
    "baseline": ".docassay/baseline.json",
    "parsers": [
      {
        "id": "reducto"
      },
      {
        "id": "file",
        "name": "pipeline",
        "options": {
          "dir": "parsed"
        }
      }
    ],
    "thresholds": {
      "default": {
        "drop": 0.02
      },
      "tables": {
        "min": 1
      }
    },
    "normalize": {
      "date_order": "dmy",
      "decimal": "."
    },
    "tokenizer": "tiktoken:cl100k_base"
  },
  "paths.yaml": {
    "version": 1,
    "golden": "../golden",
    "cache": "cache",
    "baseline": "baseline.json",
    "parsers": [
      {
        "id": "file",
        "name": "local",
        "options": {
          "dir": "out/parsed"
        }
      },
      {
        "id": "docling",
        "options": {
          "dir": "should-stay"
        }
      }
    ],
    "thresholds": {
      "default": {
        "drop": 0.02
      }
    },
    "normalize": {
      "date_order": "mdy",
      "decimal": "."
    },
    "tokenizer": "words"
  },
  "types.yaml": {
    "version": 1,
    "golden": ".",
    "cache": ".docassay/cache",
    "baseline": ".docassay/baseline.json",
    "parsers": [
      {
        "id": "llamaparse:fast",
        "options": {
          "note": "yes",
          "when": "2026-11-01",
          "mode": 15,
          "plain": 77,
          "hex": 16,
          "flag": true,
          "off": "no",
          "on": "on",
          "quoted": "077"
        }
      }
    ],
    "thresholds": {
      "default": {
        "drop": 0.02
      }
    },
    "normalize": {
      "date_order": "mdy",
      "decimal": "."
    },
    "tokenizer": "words"
  }
}
